@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="container mt-5 text-center">
    <h1 class="display-4">ICRISAT Accession Search System</h1>
    <p class="lead">Search crop accessions based on traits using our NLP-powered chatbot interface.</p>

    <div class="mt-4 d-flex justify-content-center gap-3">
        <a class="btn btn-primary btn-lg" asp-page="/Chatbot/Index">
            🚀 Go to Chatbot
        </a>
        <a class="btn btn-primary btn-lg" asp-page="/Subsetting/Index">
            🚀 Go to Subsetting Tool
        </a>
    </div>

    <hr class="my-5" />

    <div class="row mt-4">
        <div class="col-md-4">
            <h4>🔎 Intelligent Search</h4>
            <p>Query the system with natural language and find relevant accessions instantly.</p>
        </div>
        <div class="col-md-4">
            <h4>📊 Data-Driven</h4>
            <p>Results are powered by AI + database integration for accurate filtering.</p>
        </div>
        <div class="col-md-4">
            <h4>🌾 Agriculture Focused</h4>
            <p>Specifically designed for crop germplasm and trait-based queries.</p>
        </div>
    </div>
</div>
