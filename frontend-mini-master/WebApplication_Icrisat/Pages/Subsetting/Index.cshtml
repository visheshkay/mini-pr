@page "/subsetting"
@model IndexModel
@{
    ViewData["Title"] = "ICRISAT Subsetting Tool Page";
}

<div class="page-container">
    <div class="content-wrapper">
        <!-- Left Sidebar -->
        <aside class="sidebar">
            <div class="filter-section">
                <h2>Apply Filters</h2>
                <form method="post">
                    <div class="manual-filters">
                        <h3>Manual Filters</h3>
                        <div class="weather-form">
                            <!-- Temperature Range -->
                            <div class="range_container">
                                <label>Temperature Range (°C)</label>
                                <div class="sliders_control">
                                    <input id="tempFromSlider" type="range" name="TempMin" value="@Model.TempMin" min="0" max="50" />
                                    <input id="tempToSlider" type="range" name="TempMax" value="@Model.TempMax" min="0" max="50" />
                                </div>
                                <div class="form_control">
                                    <div class="form_control_container">
                                        <div class="form_control_container__time">Min</div>
                                        <input class="form_control_container__time__input" type="number" name="TempMin" id="tempFromInput" value="@Model.TempMin" min="0" max="50" />
                                    </div>
                                    <div class="form_control_container">
                                        <div class="form_control_container__time">Max</div>
                                        <input class="form_control_container__time__input" type="number" name="TempMax" id="tempToInput" value="@Model.TempMax" min="0" max="50" />
                                    </div>
                                </div>
                            </div>
                            <!-- Humidity Range -->
                            <div class="range_container">
                                <label>Humidity Range (%)</label>
                                <div class="sliders_control">
                                    <input id="humidityFromSlider" type="range" name="HumidityMin" value="@Model.HumidityMin" min="0" max="100" />
                                    <input id="humidityToSlider" type="range" name="HumidityMax" value="@Model.HumidityMax" min="0" max="100" />
                                </div>
                                <div class="form_control">
                                    <div class="form_control_container">
                                        <div class="form_control_container__time">Min</div>
                                        <input class="form_control_container__time__input" type="number" name="HumidityMin" id="humidityFromInput" value="@Model.HumidityMin" min="0" max="100" />
                                    </div>
                                    <div class="form_control_container">
                                        <div class="form_control_container__time">Max</div>
                                        <input class="form_control_container__time__input" type="number" name="HumidityMax" id="humidityToInput" value="@Model.HumidityMax" min="0" max="100" />
                                    </div>
                                </div>
                            </div>
                                    <!-- Rainfall Range -->
        <div class="range_container">
            <label>Rainfall Range (mm)</label>
            <div class="sliders_control">
                <input id="rainFromSlider" type="range" name="RainfallMin" value="@Model.RainfallMin" min="0" max="1300" />
                <input id="rainToSlider" type="range" name="RainfallMax" value="@Model.RainfallMax" min="0" max="1300" />
            </div>
            <div class="form_control">
                <div class="form_control_container">
                    <div class="form_control_container__time">Min</div>
                    <input class="form_control_container__time__input" type="number" name="RainfallMin" id="rainFromInput" value="@Model.RainfallMin" min="0" max="1300" />
                </div>
                <div class="form_control_container">
                    <div class="form_control_container__time">Max</div>
                    <input class="form_control_container__time__input" type="number" name="RainfallMax" id="rainToInput" value="@Model.RainfallMax" min="0" max="1300" />
                </div>
            </div>
        </div>
        
        <!-- Crop Filter -->
        <div class="crop_filter_container">
            <label for="cropFilter">Crop Type:</label>
            <select id="cropFilter" name="CropFilter" class="crop_dropdown">
                <option value="All" selected="@(Model.CropFilter == "All")">All Crops</option>
                <option value="Sorghum" selected="@(Model.CropFilter == "Sorghum")">Sorghum</option>
                <option value="Chickpea" selected="@(Model.CropFilter == "Chickpea")">Chickpea</option>
            </select>
        </div>

        <!-- Page Size -->
        <div class="crop_filter_container">
            <label for="pageSize">Results per page:</label>
            <select id="pageSize" name="PageSize" class="crop_dropdown">
                <option value="50" selected="@(Model.PageSize == 50)">50</option>
                <option value="100" selected="@(Model.PageSize == 100)">100</option>
                <option value="250" selected="@(Model.PageSize == 250)">250</option>
                <option value="500" selected="@(Model.PageSize == 500)">500</option>
            </select>
        </div>
        
        <!-- Submit Button -->
        <button type="submit" class="submit-button">Submit</button>
                        </div>
                    </div>
                    <input type="hidden" id="LastQuery" name="LastQuery" value="@Model.LastQuery" />
                </form>
            </div>
            <div class="chatbot-section">
                <h3>Chatbot Assistant</h3>
                <div class="chatbot-input">
                    <textarea id="chatbotInput" class="chatbot-textarea" placeholder="Ask about plant characteristics...">@Model.LastQuery</textarea>
                    <div class="chatbot-buttons">
                        <button id="chatbotSubmit" class="chatbot-button">Ask</button>
                        <button id="clearQuery" class="clear-query-button">Clear</button>
                    </div>
                </div>
                <div id="chatbotResponse" class="chatbot-response"></div>
            </div>
        </aside>
        <!-- Main Content -->
        <main class="main-content">
            <h2>Passport Data Results</h2>
            <div class="query-summary">
                <div class="summary-card">
                    <div class="summary-title">Your query</div>
                    <div class="summary-text">@(!string.IsNullOrWhiteSpace(Model.LastQuery) ? Model.LastQuery : "No query asked yet.")</div>
                </div>
                <div class="summary-card">
                    <div class="summary-title">Applied filters</div>
                    <ul class="summary-list">
                        <li><strong>Crop</strong>: @(string.IsNullOrEmpty(Model.CropFilter) ? "All" : Model.CropFilter)</li>
                        <li><strong>Temperature</strong>: @Model.TempMin to @Model.TempMax °C</li>
                        <li><strong>Humidity</strong>: @Model.HumidityMin to @Model.HumidityMax %</li>
                        <li><strong>Rainfall</strong>: @Model.RainfallMin to @Model.RainfallMax mm</li>
                    </ul>
                </div>
            </div>
            <p class="debug-info">Debug: Number of passport records received: @Model.PassportResults?.Count ?? 0</p>
            @if (Model.PassportResults != null && Model.PassportResults.Any())
            {
                <p>Showing page @Model.PageIndex of @Model.TotalPages (Total Records: @Model.TotalRecords)</p>
                <div class="export-section">
                    <button type="button" id="exportToExcel" class="export-button">
                        <i class="fas fa-file-excel"></i> Export to Excel
                    </button>
                </div>
                <div class="table-scroll-top" id="topScroll"><div></div></div>
                <div class="table-scroll-x" id="mainScroll">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>ICRISAT Accession Identifier</th>
                            <th>Accession Identifier</th>
                            <th>Crop</th>
                            <th>DOI</th>
                            <th>Genus</th>
                            <th>Species</th>
                            @if (Model.PassportResults.Any(p => p.Latitude.HasValue || p.Longitude.HasValue))
                            {
                                <th>Latitude</th>
                                <th>Longitude</th>
                            }
                            <th>Temperature (°C)</th>
                            <th>Humidity (%)</th>
                            <th>Rainfall (mm)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var passport in Model.PassportResults)
                        {
                            <tr>
                                <td>@passport.ICRISATAccessionIdentifier</td>
                                <td>@passport.AccessionIdentifier</td>
                                <td>@passport.Crop</td>
                                <td>@passport.DOI</td>
                                <td>@passport.Genus</td>
                                <td>@passport.Species</td>
                                @if (Model.PassportResults.Any(p => p.Latitude.HasValue || p.Longitude.HasValue))
                                {
                                    <td>@passport.Latitude</td>
                                    <td>@passport.Longitude</td>
                                }
                                <td>@passport.Temperature</td>
                                <td>@passport.Humidity</td>
                                <td>@passport.Rainfall</td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
                <div class="pagination">
                            @if (Model.PageIndex > 1)
        {
            <a asp-page="Index" asp-route-pageIndex="@(Model.PageIndex - 1)" asp-route-TempMin="@Model.TempMin" asp-route-TempMax="@Model.TempMax" asp-route-HumidityMin="@Model.HumidityMin" asp-route-HumidityMax="@Model.HumidityMax" asp-route-RainfallMin="@Model.RainfallMin" asp-route-RainfallMax="@Model.RainfallMax" asp-route-CropFilter="@Model.CropFilter" asp-route-LastQuery="@Model.LastQuery" asp-route-PageSize="@Model.PageSize" class="btn btn-secondary">Previous</a>
        }
        @if (Model.PageIndex < Model.TotalPages)
        {
            <a asp-page="Index" asp-route-pageIndex="@(Model.PageIndex + 1)" asp-route-TempMin="@Model.TempMin" asp-route-TempMax="@Model.TempMax" asp-route-HumidityMin="@Model.HumidityMin" asp-route-HumidityMax="@Model.HumidityMax" asp-route-RainfallMin="@Model.RainfallMin" asp-route-RainfallMax="@Model.RainfallMax" asp-route-CropFilter="@Model.CropFilter" asp-route-LastQuery="@Model.LastQuery" asp-route-PageSize="@Model.PageSize" class="btn btn-secondary">Next</a>
        }
                </div>
            }
            else
            {
                <p class="no-data">No passport data available.</p>
            }
        </main>
    </div>
</div>

